# The application image published by GitHub Actions. Pin a SHA tag in production.
APP_IMAGE=ghcr.io/owner/fair_allocation_web:latest
# Keep this password URL-safe so it can be used in DATABASE_URL without escaping.
POSTGRES_PASSWORD=replace-with-random-database-password
DATABASE_URL=postgres://fair:replace-with-random-database-password@db:5432/fair
SOLVER_TOKEN=replace-with-random-token
RATE_LIMIT_SALT=replace-with-random-salt
WEB_BIND=127.0.0.1
WEB_PORT=3000
